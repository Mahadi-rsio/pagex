{
  "name": "pagex",
  "version": "1.0.0",
  "description": "PageX - Multi-tenant static site hosting platform",
  "private": true,
  "packageManager": "pnpm@8.15.0",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:api": "cd services/api && pnpm run dev",
    "dev:blob-server": "cd services/blob-server && go run .",
    "dev:console": "cd services/console && pnpm run dev",
    "build": "turbo run build",
    "build:api": "cd services/api && pnpm run build",
    "build:blob-server": "cd services/blob-server && go build -o caddy .",
    "build:console": "cd services/console && pnpm run build",
    "lint": "turbo run lint",
    "lint:api": "cd services/api && pnpm run lint",
    "lint:console": "cd services/console && pnpm run lint",
    "test": "turbo run test",
    "test:api": "cd services/api && pnpm run test",
    "test:console": "cd services/console && pnpm run test",
    "db:generate": "cd services/api && pnpm run db:generate",
    "db:migrate": "cd services/api && pnpm run db:migrate",
    "db:push": "cd services/api && pnpm run db:push",
    "db:studio": "cd services/api && pnpm run db:studio",
    "docker:build": "docker compose -f infrastructure/docker/compose/docker-compose.yml build",
    "docker:up": "docker compose -f infrastructure/docker/compose/docker-compose.yml up -d",
    "docker:down": "docker compose -f infrastructure/docker/compose/docker-compose.yml down",
    "docker:logs": "docker compose -f infrastructure/docker/compose/docker-compose.yml logs -f",
    "docker:ps": "docker compose -f infrastructure/docker/compose/docker-compose.yml ps",
    "nix:build": "nix build",
    "nix:dev": "nix develop",
    "nix:dev:api": "nix develop -c api",
    "nix:dev:blob-server": "nix develop -c blob-server",
    "nix:dev:console": "nix develop -c console",
    "clean": "rm -rf node_modules dist .next pnpm-lock.yaml",
    "clean:all": "rm -rf node_modules services/*/node_modules services/*/dist services/*/.next pnpm-lock.yaml"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "keywords": [
    "pagex",
    "static-site",
    "hosting",
    "multi-tenant",
    "monorepo",
    "nix",
    "docker"
  ],
  "author": "",
  "license": "MIT"
}