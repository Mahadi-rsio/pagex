{
  "name": "@pagex/serverless",
  "version": "1.0.0",
  "description": "PageX API Service - Hono backend for multi-tenant static site hosting, deployable to AWS Lambda",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "npx biome format --write",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:migrate:run": "node scripts/migrate.mjs",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "keywords": [
    "pagex",
    "serverless",
    "hono",
    "lambda",
    "backend",
    "static-site",
    "hosting"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "dotenv": "^17.4.1",
    "drizzle-orm": "^0.45.2",
    "file-type": "^22.0.1",
    "hono": "^4.13.9",
    "ioredis": "^5.10.1",
    "jose": "^6.2.2",
    "mime-types": "^3.0.2",
    "minio": "^8.0.7",
    "nanoid": "^5.1.7",
    "p-limit": "^6.2.0",
    "pg": "^8.20.0",
    "postgres": "^3.4.9",
    "sharp": "^0.35.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/mime-types": "^3.0.1",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@types/sharp": "^0.31.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.1",
    "typescript": "^6.0.2"
  }
}