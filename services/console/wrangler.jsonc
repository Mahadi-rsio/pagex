{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pagex-console",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-10-08",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "pagex-console"
		}
	],
	"r2_buckets": [
		{
			"binding": "BLOBS",
			"bucket_name": "pagex-blobs-dev"
		}
	],
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "5719588386e44575bcf12822e3838253"
		}
	],
	"images": {
		"binding": "IMAGES"
	}
}