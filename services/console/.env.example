# Console UI Configuration

# Better Auth Configuration
BETTER_AUTH_SECRET=your-secret-key-here
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/console

# Redis
REDIS_URL=redis://localhost:6379

BASE_DOMAIN=localhost
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=sites
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
MINIO_REGION=us-east-1
USAGE_INGEST_TOKEN=your-ingest-token

# OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# SMTP / Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SENDER=your-email@example.com
BREVO_API_KEY=your-brevo-api-key

# SMS (optional)
SMS_TOKEN=your-sms-token

# Public URL (mapped to env.PUBLIC_URL in next.config.ts)
PUBLIC_URL=http://localhost:3000
