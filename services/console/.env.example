# Console UI Configuration

# Express API — backend server the Next.js proxy forwards to
EXPRESS_URL=http://localhost:3001

# Better Auth Configuration
BETTER_AUTH_SECRET=your-secret-key-here
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/console

# Redis
REDIS_URL=redis://localhost:6379

# OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# SMTP / Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SENDER=your-email@example.com
BREVO_API_KEY=your-brevo-api-key

# SMS (optional)
SMS_TOKEN=your-sms-token

# Public URL (mapped to env.PUBLIC_URL in next.config.ts)
PUBLIC_URL=http://localhost:3000
