# Console configuration
#
# The console runs on Vercel in production. These values are also used locally:
# the Drizzle configs and src/db/index.ts read DATABASE_URL, and the Upstash
# client reads UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN.
#
# The root ../.env.example is the reference for the full list; this file is a
# console-only subset.

# Better Auth Configuration
BETTER_AUTH_SECRET=your-secret-key-here
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173

# Neon (serverless Postgres) — single connection string, pooled endpoint
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-misty-term-az8n0461-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_POOL_MAX=5

# Upstash (serverless Redis) — REST credentials, not a wire-protocol URL
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
REDIS_KEY_PREFIX=px

BASE_DOMAIN=localhost
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=sites
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
MINIO_REGION=us-east-1
USAGE_INGEST_TOKEN=your-ingest-token

# Set to 1 on the one Vercel deploy that should apply Drizzle migrations and
# provision the storage bucket. Cold starts skip both otherwise.
# RUN_STARTUP_TASKS=1

# OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# SMTP / Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SENDER=your-email@example.com
BREVO_API_KEY=your-brevo-api-key

# SMS (optional)
SMS_TOKEN=your-sms-token

# Public URL (mapped to env.PUBLIC_URL in next.config.ts)
PUBLIC_URL=http://localhost:3000
