# Console UI Configuration

# API Service URL - Points to the PageX API service
NEXT_PUBLIC_API_URL=http://localhost:3001

# Better Auth Configuration
BETTER_AUTH_SECRET=your-secret-key-here
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/console

# Redis Configuration
REDIS_URL=redis://localhost:6379

# OAuth Configuration
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# SMTP Configuration for Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SENDER=your-email@example.com
BREVO_API_KEY=your-brevo-api-key

# SMS Configuration (optional)
SMS_TOKEN=your-sms-token

# Public URL for the console
PUBLIC_URL=http://localhost:3000