# Console configuration (Cloudflare Workers + OpenNext)
#
# Local secrets for `wrangler` / `opennextjs-cloudflare preview` live in
# `.dev.vars` (gitignored). Copy the keys below into `.dev.vars` for
# `pnpm run preview` / `wrangler dev` — Next.js `next dev` still reads `.env`.
# Bindings (BLOBS, HYPERDRIVE) are declared in `wrangler.jsonc`.
#
# The root ../.env.example remains the reference for blob-server / compose vars.

# Better Auth Configuration (required in .dev.vars for Worker preview)
BETTER_AUTH_SECRET=your-secret-key-here
# Use :3000 for next dev; :8787 for wrangler / OpenNext preview
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8787,http://localhost:5173

# Neon PostgreSQL — used by `pnpm db:migrate` and as the Hyperdrive local
# connection string fallback (CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE).
# In deployed Workers, connections go through the HYPERDRIVE binding.
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-misty-term-az8n0461-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_POOL_MAX=5

# Upstash (serverless Redis) — REST credentials, not a wire-protocol URL
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
REDIS_KEY_PREFIX=px

BASE_DOMAIN=localhost
USAGE_INGEST_TOKEN=your-ingest-token

# Optional: set to 1 only for a deliberate admin Node process that should
# apply Drizzle migrations on startup. Workers never auto-migrate.
# RUN_STARTUP_TASKS=1

# OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Public URL (mapped to env.PUBLIC_URL in next.config.ts)
PUBLIC_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Remote builds (shared Fly.io build machine)
# ---------------------------------------------------------------------------
# Shared secret the build machine presents to /api/builds/claim and
# /api/internal/builds/controller. Must match BUILD_MACHINE_TOKEN on the machine.
# Generate with: openssl rand -hex 32
BUILD_MACHINE_TOKEN=your-build-machine-token

# Fly controller credentials: the console uses these to start/stop the shared
# build machine on demand. All three are required for the controller to act.
FLY_API_TOKEN=your-fly-api-token
FLY_APP_NAME=pagex-build-runner
FLY_MACHINE_ID=your-fly-machine-id
# Self-hosted Fly-compatible API base (defaults to https://api.machines.dev):
# FLY_API_HOST=your-fly-api-host

# OpenNext / Wrangler local
NEXTJS_ENV=development
# Must be a real postgres URL (same as DATABASE_URL). Do NOT export a docs
# placeholder like YOUR_DEV_DATABASE_URL in your shell — it overrides .dev.vars
# and breaks `next build` via initOpenNextCloudflareForDev.
# CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=<same as DATABASE_URL>
