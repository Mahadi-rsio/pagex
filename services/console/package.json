{
    "name": "@pagex/console",
    "version": "1.0.0",
    "description": "PageX Console - Next.js web interface for multi-tenant static site hosting",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "build:opennext": "open-next build",
        "start": "next start",
        "lint": "npx biome format --write",
        "test": "node --import tsx --test tests/*.test.ts",
        "db:generate": "pnpm run db:generate:auth && pnpm run db:generate:api",
        "db:generate:auth": "drizzle-kit generate --config=drizzle.config.ts",
        "db:generate:api": "drizzle-kit generate --config=drizzle.api.config.ts",
        "db:migrate": "tsx scripts/migrate.ts",
        "db:push": "drizzle-kit push --config=drizzle.config.ts && drizzle-kit push --config=drizzle.api.config.ts",
        "db:studio": "drizzle-kit studio --config=drizzle.config.ts",
        "db:studio:api": "drizzle-kit studio --config=drizzle.api.config.ts"
    },
    "dependencies": {
        "@fontsource-variable/geist": "^5.3.0",
        "@radix-ui/react-accordion": "^1.2.20",
        "@radix-ui/react-alert-dialog": "^1.1.23",
        "@radix-ui/react-avatar": "^1.2.6",
        "@radix-ui/react-dialog": "^1.1.23",
        "@radix-ui/react-dropdown-menu": "^2.1.24",
        "@radix-ui/react-label": "^2.1.15",
        "@radix-ui/react-progress": "^1.1.16",
        "@radix-ui/react-select": "^2.3.7",
        "@radix-ui/react-separator": "^1.1.15",
        "@radix-ui/react-slot": "^1.3.3",
        "@radix-ui/react-tabs": "^1.1.21",
        "axios": "^1.19.0",
        "better-auth": "^1.7.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "dotenv": "^17.4.2",
        "drizzle-orm": "^0.45.2",
        "file-type": "^22.0.1",
        "ioredis": "^5.11.1",
        "jose": "^6.2.2",
        "lucide-react": "^0.544.0",
        "mime-types": "^3.0.2",
        "minio": "^8.0.7",
        "motion": "^12.43.0",
        "nanoid": "^5.1.7",
        "next": "^16.3.2",
        "next-themes": "^0.4.6",
        "nodemailer": "^8.0.11",
        "p-limit": "^6.2.0",
        "postgres": "^3.4.9",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "recharts": "^3.10.1",
        "sharp": "^0.35.3",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.6.0",
        "zod": "^4.4.3",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@biomejs/biome": "2.2.4",
        "@opennextjs/aws": "4.1.5",
        "@tailwindcss/postcss": "^4.3.3",
        "@types/mime-types": "^3.0.1",
        "@types/node": "^20.19.43",
        "@types/nodemailer": "^8.0.1",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "drizzle-kit": "^0.31.10",
        "tailwindcss": "^4.3.3",
        "tsx": "^4.23.1",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.9.3"
    }
}
