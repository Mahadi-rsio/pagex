{
    "name": "@pagex/build-runner",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "PageX shared remote build machine worker (Fly.io)",
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "start": "node dist/index.js",
        "build:watch": "tsc -p tsconfig.json --watch",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "node --import tsx --test test/*.test.ts"
    },
    "devDependencies": {
        "@types/node": "^20.11.0",
        "tsx": "^4.7.0",
        "typescript": "^5.3.0"
    }
}
