# One-shot migrator for next-web Better Auth tables (user, session, jwks, …).
# Built from config/next-web — does not require the next-web git checkout.

FROM node:24-alpine
RUN corepack enable
WORKDIR /app

COPY package.json ./
RUN corepack prepare pnpm@latest --activate && pnpm install --ignore-scripts

COPY drizzle.config.ts ./
COPY drizzle ./drizzle

ENV CI=true
CMD ["pnpm", "exec", "drizzle-kit", "migrate"]
