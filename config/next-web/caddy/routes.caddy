# Application route map — imported into the site block via `import app_routes`.
# Keep in sync with next-web src/app/**/page.tsx (static export under /srv).
# Cloudisy: reverse_proxy target is the Compose service `next_web` (not `app`).

(app_routes) {
	# --- Dynamic API (Next standalone) ---
	handle /api/* {
		reverse_proxy next_web:3000
	}

	# --- Dynamic SSG shells (runtime params → placeholder HTML) ---
	# /projects/[projectId]/overview → /projects/_/overview/
	import dynamic_ssg projectOverview "^/projects/([^/]+)/overview/?$" /projects/_/overview/index.html

	# /projects/[projectId] → /projects/_/  (exclude static /projects/new)
	import dynamic_ssg_except projectRoot "^/projects/([^/]+)/?$" /projects/_/index.html /projects/new /projects/new/

	# --- Static parent + nested pages (explicit map) ---
	import static_page home /
	import static_page login /login /login/
	import static_page projects /projects /projects/
	import static_page projectsNew /projects/new /projects/new/
	import static_page settings /settings /settings/
	import static_page billing /billing /billing/
	import static_page storage /storage /storage/
	import static_page device /device /device/
	import static_page deviceApprove /device/approve /device/approve/

	# --- Assets + fallback ---
	handle /_next/static/* {
		header Cache-Control "public, max-age=31536000, immutable"
		root * /srv
		file_server
	}

	handle /_next/* {
		header Cache-Control "public, max-age=86400"
		root * /srv
		file_server
	}

	handle {
		root * /srv
		try_files {path} {path}/ {path}/index.html /404.html
		file_server
	}
}
