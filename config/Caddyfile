{
	# Origin / file certs only — do not attempt Let's Encrypt (wildcards need DNS-01).
	auto_https off
	order static_s3 before respond
	admin 0.0.0.0:2019 {
		origins caddy_server:2019 express_app:2019 localhost 127.0.0.1:2019
	}
}

# ── Shared static site handlers (imported by HTTP + HTTPS blocks) ───────────
(static_site) {
	# Hashed assets — cache aggressively in browser (immutable)
	@hashed_assets path *.js *.css *.woff2 *.woff *.ttf
	# HTML & other assets — must revalidate with server
	@revalidate_assets not path *.js *.css *.woff2 *.woff *.ttf

	header @hashed_assets Cache-Control "public, max-age=31536000, immutable"
	header @revalidate_assets Cache-Control "public, max-age=0, must-revalidate"

	# Media files: redirect client directly to MinIO to save VPS bandwidth
	@media path *.png *.jpg *.jpeg *.gif *.mp4 *.pdf *.zip *.mp3 *.ico *.webp *.svg

	handle @media {
		static_s3 {
			endpoint       {$MINIO_ENDPOINT_URL:http://minio:9000}
			bucket         {$MINIO_BUCKET}
			access_key     {$S3_ACCESS_KEY}
			secret_key     {$S3_SECRET_KEY}
			use_path_style true

			base_domain    {$BASE_DOMAIN:localhost}

			redirect_to_s3   true
			presign_redirect true
			presign_lifetime 15m

			fallback_except png jpg jpeg gif mp4 pdf zip mp3 ico webp svg css js woff woff2 ttf map
		}
	}

	# All other requests: serve from Caddy with LRU memory cache
	handle {
		static_s3 {
			endpoint       {$MINIO_ENDPOINT_URL:http://minio:9000}
			bucket         {$MINIO_BUCKET}
			access_key     {$S3_ACCESS_KEY}
			secret_key     {$S3_SECRET_KEY}
			use_path_style true

			base_domain    {$BASE_DOMAIN:localhost}

			cache_ttl      2m
			cache_size     1000
			max_cache_size 512KiB

			fallback_except png jpg jpeg gif mp4 pdf zip mp3 ico webp svg css js woff woff2 ttf map

			analytics on
		}
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 50mb
			roll_keep 2
			roll_keep_for 2h
		}
		format json
	}
}

# ── Local testing: plain HTTP (no TLS) ──────────────────────────────────────
# Visit: http://<project>.localhost/  and  http://api.localhost/
http://*.{$BASE_DOMAIN:localhost} {
	import static_site
}

http://api.{$BASE_DOMAIN:localhost} {
	reverse_proxy app:3000
}

# Also accept bare localhost API for convenience during local runs
http://localhost {
	reverse_proxy app:3000
}

# ── HTTPS (self-signed / Origin cert) ───────────────────────────────────────
# Visit: https://<project>.localhost/  (browser will warn on dummy cert)
*.{$BASE_DOMAIN:localhost} {
	tls /etc/caddy/certs/cert.pem /etc/caddy/certs/key.pem
	import static_site
}

api.{$BASE_DOMAIN:localhost} {
	tls /etc/caddy/certs/cert.pem /etc/caddy/certs/key.pem
	reverse_proxy app:3000
}
