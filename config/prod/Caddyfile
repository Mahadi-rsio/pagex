# =============================================================
# Production Caddyfile — Multi-tenant SaaS (cloudisy.top)
# Tier 1 only: *.cloudisy.top → Cloudflare Origin Cert
# =============================================================

{
    email rsioex@gmail.com

    admin 0.0.0.0:2019 {
        origins caddy_server:2019 express_app:2019 localhost 127.0.0.1:2019
    }

    servers {
        timeouts {
            read_body   10s
            read_header 10s
            write       30s
            idle        2m
        }
    }
}

# -----------------------------------------------------------------
# Snippet: Security headers
# -----------------------------------------------------------------
(security_headers) {
    header {
        X-Frame-Options           "SAMEORIGIN"
        X-Content-Type-Options    "nosniff"
        X-XSS-Protection          "1; mode=block"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        Referrer-Policy           "strict-origin-when-cross-origin"
        Permissions-Policy        "geolocation=(), microphone=(), camera=()"
        -Server
    }
}

# -----------------------------------------------------------------
# Snippet: Access log
# -----------------------------------------------------------------
(access_log) {
    log {
        output file /var/log/caddy/access.log {
            roll_size     50mb
            roll_keep     5
            roll_keep_for 7d
        }
        format json
        level  INFO
    }
}

# -----------------------------------------------------------------
# Snippet: Block common attack paths
# -----------------------------------------------------------------
(block_attacks) {
    @blocked path /wp-admin* /wp-login* /.env /.git* /xmlrpc.php /phpmyadmin*
    respond @blocked 404
}

# =================================================================
# App dashboard  →  https://app.cloudisy.top
# =================================================================
app.cloudisy.top {
    import security_headers
    import access_log
    import block_attacks

    respond "hello"
    # TODO: import spa app express_app:3001
}

# =================================================================
# Backend API  →  https://api.cloudisy.top
# =================================================================
api.cloudisy.top {
    import security_headers
    import access_log
    import block_attacks

    header Access-Control-Allow-Origin  "https://app.cloudisy.top"
    header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
    header Access-Control-Allow-Headers "Content-Type, Authorization"

    @options method OPTIONS
    respond @options 204

    reverse_proxy app:3000 {
        header_up X-Real-IP         {remote_host}
        header_up X-Forwarded-For   {remote_host}
        header_up X-Forwarded-Proto {scheme}

        health_uri      /health
        health_interval 15s
        health_timeout  5s
        health_status   200

        transport http {
            dial_timeout            5s
            response_header_timeout 30s
        }
    }
}

# =================================================================
# Tier 1: Free subdomain  →  *.cloudisy.top
# Cloudflare Origin Certificate (orange cloud proxy)
# =================================================================
*.cloudisy.top {
    import security_headers
    import access_log
    import block_attacks

    tls /etc/caddy/certs/cloudflare-origin.pem /etc/caddy/certs/cloudflare-origin-key.pem

    header Access-Control-Allow-Origin  "*"
    header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
    header Access-Control-Allow-Headers "Content-Type, Authorization"

    @options method OPTIONS
    respond @options 204

    reverse_proxy app:3000 {
        header_up X-Real-IP         {http.request.header.CF-Connecting-IP}
        header_up X-Forwarded-For   {http.request.header.CF-Connecting-IP}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Tenant-Domain   {host}

        health_uri      /health
        health_interval 15s
        health_timeout  5s
        health_status   200

        transport http {
            dial_timeout            5s
            response_header_timeout 30s
        }
    }
}
