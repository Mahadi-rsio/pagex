# ---------------------------------------------------------------------------
# PageX logs service (service/logs)
#
# Used by infra/setup.sh (read from service/logs/.env) and referenced when
# setting Fly/Wrangler secrets. Never commit real values.
# ---------------------------------------------------------------------------

# --- Cloudflare API (setup) ------------------------------------------------
# Token needs: Zone -> Logs -> Edit, Account -> Workers R2 Storage -> Edit,
# Account -> Queues -> Edit, Account -> Logpush -> Edit (as applicable).
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_ZONE_ID=

# --- R2 (Logpush destination + worker reads) -------------------------------
# R2_ACCOUNT_ID defaults to CF_ACCOUNT_ID when unset.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_LOGS_BUCKET=logs-raw
R2_PREFIX=raw/

# --- Cloudflare Queue ------------------------------------------------------
CF_QUEUE_NAME=pagex-logs
# CF_QUEUE_ID is filled in by infra/setup.sh (also a Fly secret).
CF_QUEUE_ID=
# Queues read+write token used by the worker to pull/ack messages.
CF_QUEUE_API_TOKEN=

# --- Neon ---------------------------------------------------------------
# Direct (non-pooled) URL: applies db/migrations/001_init.sql.
LOGS_DATABASE_URL_DIRECT=
# Pooled URL: the worker runtime connection (Fly secret DATABASE_URL).
LOGS_DATABASE_URL=

# --- Worker runtime --------------------------------------------------------
LOGS_HOST_SUFFIX=.cloudisy.top
LOGS_DRAIN_BATCH=100
LOGS_DRAIN_MAX=10
LOGS_MAX_FILES=200
# Days of raw/YYYYMMDD/ prefixes scanned as the ingest fallback. Logpush
# writes to R2 server-side and does not raise S3 event notifications, so the
# worker lists recent prefixes instead of relying on the queue alone.
LOGS_SCAN_DAYS=2

# --- Fly.io ----------------------------------------------------------------
FLY_APP=pagex-logs
FLY_ORG=
# FLY_MACHINE_ID is filled in by infra/setup.sh; set it in cron/wrangler.toml.
FLY_MACHINE_ID=
# Fly deploy token for the cron worker (set as a Wrangler secret, not here).
FLY_API_TOKEN=
