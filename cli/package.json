{
  "name": "pagex",
  "version": "1.0.0",
  "description": "CLI tool to deploy web projects to the PageX cloud platform",
  "main": "dist/index.js",
  "bin": {
    "pagex": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "cli",
    "deploy",
    "pagex",
    "cloud"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "axios": "^1.13.6",
    "better-auth": "^1.5.3",
    "chalk": "^5.6.2",
    "dotenv": "^16.4.7",
    "open": "^11.0.0",
    "ora": "^9.3.0",
    "p-limit": "^7.3.0",
    "prompts": "^2.4.2",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "@types/prompts": "^2.4.9",
    "@types/yargs": "^17.0.35",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0"
  }
}
