# PageX CLI – Environment Variables
# Copy this file to .env and fill in your values.

# Base URL for the PageX API server (default: http://localhost:3000)
PAGEX_API_URL=http://localhost:3000

# Base URL for the PageX auth/console server (default: http://localhost:3080)
PAGEX_AUTH_URL=http://localhost:3080

# OAuth device-flow client ID (default: pagex)
PAGEX_CLIENT_ID=pagex
