---
import Icon from "./Icon.astro";

const columns = [
  {
    title: "Product",
    links: ["Static hosting", "Containers", "Cloud builds", "Preview deploys", "Pricing"],
  },
  {
    title: "Developers",
    links: ["Documentation", "CLI reference", "API", "Changelog", "Status"],
  },
  {
    title: "Company",
    links: ["About", "Blog", "Careers", "Contact", "Brand"],
  },
  {
    title: "Legal",
    links: ["Privacy", "Terms", "DPA", "Security"],
  },
];
---
<footer class="relative border-t border-line">
  <div class="shell py-16">
    <div class="grid gap-12 lg:grid-cols-[1.4fr_repeat(4,1fr)]">
      <div>
        <a href="#top" class="flex items-center gap-2.5" aria-label="PageX home">
          <span
            class="grid size-8 place-items-center rounded-[9px] border border-line-strong bg-gradient-to-b from-ink-700 to-ink-900"
          >
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M2 12.5 12.5 2" stroke="white" stroke-width="1.6" stroke-linecap="round" />
              <path d="M6.5 14 14 6.5" stroke="white" stroke-width="1.6" stroke-linecap="round" opacity="0.45" />
              <circle cx="3" cy="3" r="1.75" fill="white" />
            </svg>
          </span>
          <span class="text-[15px] font-semibold tracking-tight"
            >PageX<span class="text-muted">.dev</span></span
          >
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-muted">
          Deploy static sites and containers in seconds. Built for teams that
          ship.
        </p>
        <div class="mt-6 flex items-center gap-2">
          {
            [
              { n: "github", label: "GitHub" },
              { n: "x", label: "X" },
              { n: "discord", label: "Discord" },
            ].map((s) => (
              <a
                href="#"
                aria-label={s.label}
                class="grid size-9 place-items-center rounded-xl border border-line bg-white/[0.02] text-muted transition-colors duration-200 hover:border-line-strong hover:text-fg"
              >
                <Icon name={s.n} size={16} />
              </a>
            ))
          }
        </div>
      </div>

      {
        columns.map((col) => (
          <div>
            <h3 class="font-mono text-[10px] uppercase tracking-widest text-muted">
              {col.title}
            </h3>
            <ul class="mt-4 space-y-3">
              {col.links.map((l) => (
                <li>
                  <a
                    href="#"
                    class="text-sm text-ink-200 transition-colors duration-200 hover:text-fg"
                  >
                    {l}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div
      class="mt-14 flex flex-col items-start justify-between gap-4 border-t border-line pt-7 sm:flex-row sm:items-center"
    >
      <p class="font-mono text-[11px] text-muted">
        © {new Date().getFullYear()} PageX. All rights reserved.
      </p>
      <div class="flex items-center gap-5 font-mono text-[11px] text-muted">
        <span class="flex items-center gap-2">
          <span class="relative flex size-1.5">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-white/70"
            ></span>
            <span class="relative inline-flex size-1.5 rounded-full bg-white"></span>
          </span>
          All systems operational
        </span>
        <span class="hidden sm:inline">v1.6.0</span>
      </div>
    </div>
  </div>
</footer>
