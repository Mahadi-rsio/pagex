---
import Icon from "./Icon.astro";

// NOTE: Free-tier values are exact. Paid-tier numbers are placeholders — edit
// before launch.
const tiers = [
  {
    name: "Hobby",
    tag: "Static + Containers",
    monthly: 0,
    yearly: 0,
    cta: "Start free",
    highlight: false,
    blurb: "Everything you need to ship your first project. Free forever.",
    features: [
      "100k requests / month",
      "Unlimited static sites",
      "Cloud builds · Git · Auto deploy",
      "Instant rollback + free SSL",
      "5 CU·h containers / month",
      "Community support",
    ],
  },
  {
    name: "Pro",
    tag: "For growing teams",
    monthly: 20,
    yearly: 16,
    cta: "Start 14-day trial",
    highlight: true,
    blurb: "More headroom, teams and the controls production demands.",
    features: [
      "1M requests / month included",
      "100 GB bandwidth",
      "100 CU·h containers / month",
      "Team members & roles",
      "Custom + wildcard domains",
      "Password-protected previews",
      "Email support",
    ],
  },
  {
    name: "Scale",
    tag: "For high traffic",
    monthly: 99,
    yearly: 82,
    cta: "Talk to us",
    highlight: false,
    blurb: "Serious capacity with the guarantees enterprises expect.",
    features: [
      "10M+ requests / month",
      "1 TB+ bandwidth",
      "500+ CU·h containers",
      "SSO / SAML & audit logs",
      "99.99% uptime SLA",
      "Dedicated support & onboarding",
    ],
  },
];
---
<section id="pricing" class="relative py-24 sm:py-32">
  <div class="shell">
    <div class="reveal mx-auto max-w-2xl text-center">
      <span class="eyebrow">Pricing</span>
      <h2
        class="mt-4 text-balance text-3xl font-semibold tracking-[-0.03em] sm:text-4xl lg:text-[2.75rem]"
      >
        Start free. Upgrade when you grow.
      </h2>
      <p class="mt-4 text-muted">
        The free tier never expires. Paid tiers add capacity, collaboration and
        guarantees.
      </p>

      <!-- toggle -->
      <div class="mt-8 flex items-center justify-center gap-3">
        <div
          class="inline-flex items-center rounded-full border border-line bg-white/[0.02] p-1 font-mono text-[11px]"
          role="tablist"
          aria-label="Billing period"
        >
          <button
            type="button"
            id="bill-monthly"
            class="rounded-full px-4 py-1.5 text-ink-200 transition-colors aria-selected:bg-fg aria-selected:text-ink-950"
            role="tab"
            aria-selected="false"
          >
            Monthly
          </button>
          <button
            type="button"
            id="bill-yearly"
            class="rounded-full px-4 py-1.5 text-ink-200 transition-colors aria-selected:bg-fg aria-selected:text-ink-950"
            role="tab"
            aria-selected="true"
          >
            Yearly
          </button>
        </div>
        <span class="font-mono text-[11px] text-muted">save 20%</span>
      </div>
    </div>

    <div class="mt-14 grid gap-5 lg:grid-cols-3">
      {
        tiers.map((t) => (
          <div
            class:list={[
              "reveal relative flex flex-col rounded-[22px] border p-7 transition-transform duration-300 hover:-translate-y-1",
              t.highlight
                ? "border-line-strong bg-gradient-to-b from-ink-800 to-ink-900 shadow-lift"
                : "border-line bg-card",
            ]}
          >
            {t.highlight && (
              <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-fg px-3 py-1 font-mono text-[9px] uppercase tracking-widest text-ink-950">
                Most popular
              </span>
            )}

            <div class="flex items-baseline justify-between">
              <h3 class="text-lg font-semibold tracking-tight">{t.name}</h3>
              <span class="font-mono text-[10px] uppercase tracking-widest text-muted">
                {t.tag}
              </span>
            </div>

            <div class="mt-5 flex items-end gap-2">
              <span class="text-5xl font-semibold tracking-tight tabular-nums">
                <span class="align-top text-2xl text-ink-300">$</span>
                <span class="price" data-monthly={t.monthly} data-yearly={t.yearly}>
                  {t.yearly}
                </span>
              </span>
              <span class="mb-1.5 font-mono text-[11px] text-muted">
                /mo{t.yearly > 0 ? " billed yearly" : " forever"}
              </span>
            </div>

            <p class="mt-3 text-sm text-muted">{t.blurb}</p>

            <a
              href="#"
              class:list={[
                "mt-6 inline-flex h-11 items-center justify-center gap-2 rounded-full text-sm font-semibold transition-transform duration-200 hover:-translate-y-0.5",
                t.highlight
                  ? "bg-fg text-ink-950"
                  : "border border-line bg-white/[0.03] text-fg hover:border-line-strong",
              ]}
            >
              {t.cta}
            </a>

            <div class="mt-7 h-px bg-line"></div>

            <ul class="mt-6 space-y-3.5">
              {t.features.map((f) => (
                <li class="flex items-start gap-3 text-sm">
                  <span class="mt-0.5 grid size-4 shrink-0 place-items-center rounded-full bg-white/10 text-white">
                    <Icon name="check" size={10} stroke={2.6} />
                  </span>
                  <span class="text-ink-100">{f}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <p class="mt-8 text-center font-mono text-[11px] text-muted">
      All plans include cloud builds, Git, auto deploy, rollback and free SSL.
    </p>
  </div>
</section>

<script>
  const monthly = document.getElementById("bill-monthly");
  const yearly = document.getElementById("bill-yearly");
  const prices = document.querySelectorAll<HTMLElement>(".price");

  function set(period: "monthly" | "yearly") {
    monthly?.setAttribute("aria-selected", String(period === "monthly"));
    yearly?.setAttribute("aria-selected", String(period === "yearly"));
    prices.forEach((p) => {
      const v = period === "monthly" ? p.dataset.monthly : p.dataset.yearly;
      if (v != null) p.textContent = v;
    });
  }

  monthly?.addEventListener("click", () => set("monthly"));
  yearly?.addEventListener("click", () => set("yearly"));
</script>
