NODE_ENV=production
PUBLIC_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Set either to "false" to disable email/password login (OAuth still works).
# Server gate (Better Auth) + client UI gate must both be set.
ENABLE_EMAIL_PASSWORD=true
NEXT_PUBLIC_ENABLE_EMAIL_PASSWORD=true

DATABASE_URL=postgres://postgres:postgres@postgres:5432/next_web
REDIS_URL=redis://redis:6379

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SMTP_HOST=
SMTP_PORT=587
SENDER=
BREVO_API_KEY=
SMS_TOKEN=
