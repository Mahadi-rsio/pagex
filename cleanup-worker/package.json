{
    "name": "@pagex/cleanup-worker",
    "version": "0.1.0",
    "private": true,
    "description": "Cloudflare Worker queue consumer for pagex-background: prunes expired deployments, orphaned R2 blobs, manifests, and deleted-project storage.",
    "type": "module",
    "scripts": {
        "dev": "wrangler dev",
        "cf-typegen": "wrangler types",
        "typecheck": "tsc --noEmit",
        "build": "wrangler types && tsc --noEmit",
        "test": "node --import tsx --test tests/*.test.ts",
        "deploy": "wrangler deploy",
        "lint": "biome format --write"
    },
    "dependencies": {
        "@upstash/redis": "^1.39.0",
        "drizzle-orm": "^0.45.2",
        "pg": "^8.16.3",
        "pg-cloudflare": "^1.2.7"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.2.4",
        "@types/node": "^20.19.43",
        "@types/pg": "^8.15.5",
        "tsx": "^4.23.1",
        "typescript": "^5.9.3",
        "wrangler": "^4.148.0"
    }
}
