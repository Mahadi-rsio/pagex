{
	auto_https off
	order static_s3 before respond
	admin 0.0.0.0:2019
}

# Console — reverse-proxy to Next.js standalone
:3080 {
	encode gzip zstd

	handle /_next/static/* {
		header Cache-Control "public, max-age=31536000, immutable"
		reverse_proxy console:3001
	}

	handle /* {
		reverse_proxy console:3001
	}
}

# Tenant sites — served via static_s3.
# Catch-all host route: subdomain depths (e.g. hello.1501.localhost) can be
# arbitrary, and `*.localhost` only matches a single label. The plugin
# validates the .{$BASE_DOMAIN} suffix itself in ServeHTTP.
http:// {
	@hashed_assets path *.js *.css *.woff2 *.woff *.ttf
	@revalidate_assets not path *.js *.css *.woff2 *.woff *.ttf

	header @hashed_assets Cache-Control "public, max-age=31536000, immutable"
	header @revalidate_assets Cache-Control "public, max-age=0, must-revalidate"

	@media path *.png *.jpg *.jpeg *.gif *.mp4 *.pdf *.zip *.mp3 *.ico *.webp *.svg

	handle @media {
		static_s3 {
			endpoint        {$MINIO_ENDPOINT_URL:http://minio:9000}
			bucket          {$MINIO_BUCKET:sites}
			access_key      {$S3_ACCESS_KEY}
			secret_key      {$S3_SECRET_KEY}
			use_path_style  true
			base_domain     {$BASE_DOMAIN:localhost}
			db_dsn          "postgres://{$POSTGRES_USER:postgres}:{$POSTGRES_PASSWORD:postgres}@db:5432/{$POSTGRES_DB:pagex}?sslmode=disable"
			redis_url       "redis://redis:6379/0"
			redirect_to_s3   {$REDIRECT_TO_S3:false}
			presign_redirect {$PRESIGN_REDIRECT:false}
			presign_lifetime {$PRESIGN_LIFETIME:15m}
			# Media shares the same LRU/body-cache architecture as every other
			# route — path + blob bodies for images/fonts are cached in-process.
			cache_ttl       {$CACHE_TTL:2m}
			cache_size      {$CACHE_SIZE:1000}
			max_cache_size  {$MAX_CACHE_SIZE:512KiB}
		}
	}

	handle {
		static_s3 {
			endpoint        {$MINIO_ENDPOINT_URL:http://minio:9000}
			bucket          {$MINIO_BUCKET:sites}
			access_key      {$S3_ACCESS_KEY}
			secret_key      {$S3_SECRET_KEY}
			use_path_style  true
			base_domain     {$BASE_DOMAIN:localhost}
			db_dsn          "postgres://{$POSTGRES_USER:postgres}:{$POSTGRES_PASSWORD:postgres}@db:5432/{$POSTGRES_DB:pagex}?sslmode=disable"
			redis_url       "redis://redis:6379/0"
			redirect_to_s3   false
			cache_ttl       {$CACHE_TTL:2m}
			cache_size      {$CACHE_SIZE:1000}
			max_cache_size  {$MAX_CACHE_SIZE:512KiB}
			analytics       on
		}
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 50mb
			roll_keep 2
			roll_keep_for 2h
		}
		format json
	}
}

# HTTPS site blocks (wildcard tenant cert + api/app prod hosts) live in
# /etc/caddy/tls/{$TLS_CFG:tls-off}.conf — enabled only when TLS_CFG=tls-on
# (production). Local/dev keeps TLS off to avoid Cloudflare DNS-01 ACME.
import /etc/caddy/tls/{$TLS_CFG:tls-off}.conf

http://api.localhost {
	reverse_proxy api:3000
}

http://localhost {
	reverse_proxy api:3000
}
