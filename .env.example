# PageX Configuration Example
# ============================================================================
# This is an EXAMPLE file. Copy to infrastructure/configs/.env for Docker Compose
# or to .env for local development.
#
# For Docker Compose (RECOMMENDED):
#   cp .env.example infrastructure/configs/.env
#   Edit infrastructure/configs/.env with your values
#   docker compose -f docker-compose.yml up
#
# For Local Development (without Docker):
#   cp .env.example .env
#   Edit .env with localhost references
#   pnpm install && pnpm run dev

# ============================================================================
# REQUIRED CONFIGURATION
# ============================================================================

# Authentication Secret (REQUIRED)
# Generate with: openssl rand -hex 32
# Or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=your-32-character-hex-secret-here

# Base Domain (REQUIRED)
# For local dev: localhost
# For production: yourdomain.com
BASE_DOMAIN=localhost

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# For Docker Compose: Use service hostname 'db'
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pagex
DB=postgresql://postgres:postgres@db:5432/pagex
DIRECT_DB=postgresql://postgres:postgres@db:5432/pagex
NEXT_WEB_DATABASE_URL=postgresql://postgres:postgres@db:5432/pagex

# For Local Development (without Docker): Use localhost
# DB=postgresql://postgres:postgres@localhost:5432/pagex
# DIRECT_DB=postgresql://postgres:postgres@localhost:5432/pagex
# NEXT_WEB_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pagex

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================

# For Docker Compose: Use service hostname 'redis'
REDIS_URL=redis://redis:6379

# For Local Development: Use localhost
# REDIS_URL=redis://localhost:6379

# ============================================================================
# STORAGE CONFIGURATION (MinIO / S3)
# ============================================================================

# S3 Access Credentials
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key

# MinIO Configuration (self-hosted)
# IMPORTANT: MINIO_ENDPOINT_URL MUST include scheme (http:// or https://)
# The Go AWS SDK v2 requires a valid URL scheme
MINIO_ENDPOINT=your-minio-server.com
MINIO_ENDPOINT_URL=https://your-minio-server.com
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_BUCKET=pagex-blobs

# AWS S3 Configuration
# MINIO_ENDPOINT=s3.amazonaws.com
# MINIO_ENDPOINT_URL=https://s3.amazonaws.com
# MINIO_PORT=443
# MINIO_USE_SSL=true
# MINIO_BUCKET=your-bucket-name

# Cloudflare R2 Configuration
# MINIO_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# MINIO_PORT=443
# MINIO_USE_SSL=true
# MINIO_BUCKET=your-r2-bucket-name

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

NODE_ENV=development
IN_DOCKER_COMPOSE=1
PUBLIC_URL=http://localhost:3080

# Authentication
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3001,http://localhost:3080
AUTH_JWKS_URL=http://console:3000/api/auth/jwks

# ============================================================================
# CACHE CONFIGURATION
# ============================================================================

CACHE_TTL=10m
CACHE_SIZE=2000
MAX_CACHE_SIZE=5MB

# ============================================================================
# S3 REDIRECT CONFIGURATION (Bandwidth Optimization)
# ============================================================================

# Enable to redirect clients directly to S3 (saves VPS bandwidth)
REDIRECT_TO_S3=false

# Enable for private buckets (generates pre-signed URLs)
PRESIGN_REDIRECT=false
PRESIGN_LIFETIME=15m

# ============================================================================
# EMAIL CONFIGURATION (Optional)
# ============================================================================

ENABLE_EMAIL_PASSWORD=true
NEXT_PUBLIC_ENABLE_EMAIL_PASSWORD=true

# SMTP Settings (example for SendGrid)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-api-key
SENDER=noreply@yourdomain.com

# ============================================================================
# OAUTH CONFIGURATION (Optional)
# ============================================================================

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================================================
# BUILD CONFIGURATION
# ============================================================================

BUILD_ENV_IMAGE=cloudisy-build-env:latest
BUILD_WORKSPACE=/tmp/cloudisy-builds

# ============================================================================
# DEPLOYMENT CONFIGURATION
# ============================================================================

DEPLOYMENT_RETENTION=10
BLOB_RETENTION_DAYS=30
MAX_FILE_SIZE=10485760
MAX_FILES_PER_DEPLOY=100

# ============================================================================
# THIRD-PARTY SERVICES (Optional)
# ============================================================================

BREVO_API_KEY=
SMS_TOKEN=
