# PageX Configuration Example
# ============================================================================
# This is an EXAMPLE file. Copy to .env in the repo root.
#
# Docker runs the blob-server (Caddy + static_s3) and the Vector access-log
# pipeline only. The console is hosted on Vercel; Postgres is Neon and Redis is
# Upstash. There is no console/db/redis container.
#
#   cp .env.example .env      # then fill in the required values
#   docker compose up -d      # blob-server + vector
#
# To run the console locally against the same Neon/Upstash project:
#   pnpm install && pnpm dev:console
# ============================================================================
# ============================================================================
# REQUIRED CONFIGURATION
# ============================================================================

# Authentication Secret (REQUIRED)
# Generate with: openssl rand -hex 32
# Or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=your-32-character-hex-secret-here

# Base Domain (REQUIRED)
# For local dev: localhost
# For production: yourdomain.com
BASE_DOMAIN=localhost

# Caddy TLS / HTTPS (blob-server)
# Local dev: tls-off (no HTTPS, no Cloudflare DNS-01 cert provisioning)
# Production: tls-on (requires CLOUDFLARE_API_TOKEN)
TLS_CFG=tls-off

# ============================================================================
# ============================================================================
# DATABASE CONFIGURATION (Neon — serverless Postgres)
# ============================================================================

# Single connection string used by the console, the Drizzle configs, and the
# blob-server's static_s3 site lookups. Use Neon's POOLED endpoint here
# (hostname ends in -pooler); it is PgBouncer-compatible, which is why the
# client connects with `prepare: false`.
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-misty-term-az8n0461-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Run migrations against Neon's direct (unpooled) endpoint to avoid contention
# on the DDL lock, on the deploy you want to migrate:
#   RUN_STARTUP_TASKS=1
#   DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-misty-term-az8n0461.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Optional: cap concurrent Postgres connections per serverless instance.
DATABASE_POOL_MAX=5

# ============================================================================
# REDIS CONFIGURATION (Upstash — serverless Redis)
# ============================================================================

# Upstash speaks REST rather than the Redis wire protocol. Both values come from
# the Upstash console (Database → REST). All caching, rate limiting, deploy
# tokens, and page deploy locks go through this one database.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Optional: key namespace, so several environments can share one database.
REDIS_KEY_PREFIX=px

# ============================================================================
# STORAGE CONFIGURATION (MinIO / S3)
# ============================================================================

# S3 Access Credentials
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key

CLOUDFLARE_API_TOKEN=

# MinIO Configuration (self-hosted)
# IMPORTANT: MINIO_ENDPOINT_URL MUST include scheme (http:// or https://)
# The Go AWS SDK v2 requires a valid URL scheme
MINIO_ENDPOINT=your-minio-server.com
MINIO_ENDPOINT_URL=https://your-minio-server.com
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_BUCKET=pagex-blobs

# AWS S3 Configuration
# MINIO_ENDPOINT=s3.amazonaws.com
# MINIO_ENDPOINT_URL=https://s3.amazonaws.com
# MINIO_PORT=443
# MINIO_USE_SSL=true
# MINIO_BUCKET=your-bucket-name

# Cloudflare R2 Configuration
# MINIO_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# MINIO_PORT=443
# MINIO_USE_SSL=true
# MINIO_BUCKET=your-r2-bucket-name

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

NODE_ENV=development
PUBLIC_URL=http://localhost:3080

# Authentication
BETTER_AUTH_URL=http://localhost:3080
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3080

# Origin the blob-server's Caddy console host blocks reverse-proxy to. This is
# the console's public origin — the Vercel deployment URL in production.
# CONSOLE_UPSTREAM=http://localhost:3000

# Set to 1 on the one Vercel deploy that should apply Drizzle migrations and
# provision the storage bucket. Left unset, serverless cold starts skip both.
# RUN_STARTUP_TASKS=1

# ============================================================================
# USAGE INGEST (Vector → API)
# ============================================================================

# Shared secret for POST /internal/usage/ingest. Must match between the
# console and vector services. Generate with: openssl rand -hex 32
USAGE_INGEST_TOKEN=your-usage-ingest-token-here

# Vector → console ingest URL. The console is no longer a compose service, so
# point this at the Vercel deployment origin.
# USAGE_API_URL=https://your-app.vercel.app/internal/usage/ingest

# ============================================================================
# CACHE CONFIGURATION
# ============================================================================

CACHE_TTL=10m
CACHE_SIZE=2000
MAX_CACHE_SIZE=5MB

# ============================================================================
# S3 REDIRECT CONFIGURATION (Bandwidth Optimization)
# ============================================================================

# Enable to redirect clients directly to S3 (saves VPS bandwidth)
REDIRECT_TO_S3=false

# Enable for private buckets (generates pre-signed URLs)
PRESIGN_REDIRECT=false
PRESIGN_LIFETIME=15m

# ============================================================================
# EMAIL CONFIGURATION (Optional)
# ============================================================================

ENABLE_EMAIL_PASSWORD=true
NEXT_PUBLIC_ENABLE_EMAIL_PASSWORD=true

# SMTP Settings (example for SendGrid)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-api-key
SENDER=noreply@yourdomain.com

# ============================================================================
# OAUTH CONFIGURATION (Optional)
# ============================================================================

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================================================
# DEPLOYMENT CONFIGURATION
# ============================================================================

DEPLOYMENT_RETENTION=10
BLOB_RETENTION_DAYS=30
MAX_FILE_SIZE=10485760
MAX_FILES_PER_DEPLOY=100

# ============================================================================
# THIRD-PARTY SERVICES (Optional)
# ============================================================================

BREVO_API_KEY=
SMS_TOKEN=
