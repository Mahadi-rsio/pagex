{
  "name": "Dashboard",
  "tag": "div",
  "props": {
    "className": { "expr": "`dashboard ${theme}`" },
    "data-layout": "grid"
  },
  "children": [
    {
      "tag": "header",
      "props": { "className": "dashboard-header" },
      "children": [
        { "tag": "h1", "children": ["Welcome, ", { "expr": "user.name" }] },
        {
          "tag": "input",
          "props": {
            "type": "search",
            "placeholder": "Search projects...",
            "value": { "expr": "search" },
            "onChange": { "expr": "(e) => onSearch(e.target.value)" }
          }
        }
      ]
    },
    {
      "tag": "nav",
      "props": { "className": "sidebar", "aria-label": "Primary navigation" },
      "children": [
        {
          "tag": "ul",
          "children": [
            {
              "tag": "li",
              "children": { "expr": "navItems.map((n) => <a href={n.href} className='nav-link'>{n.label}</a>)" }
            }
          ]
        }
      ]
    },
    {
      "tag": "main",
      "props": { "className": "dashboard-content" },
      "children": [
        {
          "tag": "section",
          "props": { "className": "stats-grid" },
          "children": {
            "expr": "stats.map((s) => <div className='stat-card' key={s.label}><h3>{s.label}</h3><p>{s.value}</p></div>)"
          }
        },
        {
          "tag": "section",
          "props": { "className": "activity" },
          "children": [
            { "tag": "h2", "children": "Recent activity" },
            {
              "tag": "ul",
              "children": {
                "expr": "activities.length > 0 ? activities.map((a) => <li key={a.id}><span>{a.title}</span><time>{a.date}</time></li>) : <li className='empty'>No activity yet</li>"
              }
            }
          ]
        },
        {
          "tag": "div",
          "props": { "className": "filters" },
          "children": {
            "expr": "filters.map((f) => <button key={f.id} onClick={() => onToggleFilter(f.id)} disabled={!f.active}>{f.label}</button>)"
          }
        }
      ]
    },
    {
      "tag": "footer",
      "props": { "className": "dashboard-footer" },
      "children": [
        {
          "tag": "p",
          "children": [
            "Built with ",
            { "expr": "framework" },
            " · v",
            { "expr": "version" }
          ]
        },
        {
          "tag": "span",
          "props": { "className": "status" },
          "children": { "expr": "isOnline ? 'Online' : 'Offline'" }
        }
      ]
    }
  ]
}
